# Copy this file to mainserver/.env and edit. Never commit the real .env.

# --- Django ---
DEBUG=True
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Model (required) ---
# Trained YOLOv8 *segmentation* weights. Absolute path, or relative to the repo root.
MODEL_PATH=TrainedModelv2/best.pt
# Inference size. 1024 is the app's original setting; the notebook trained at 640,
# so compare both on a few of your images (small organelles often need the larger size).
IMG_SIZE=1024
CONFIDENCE_THRESHOLD=0.5
# Containment test for organelles: mask (default) or hull (convex hull of the
# etioplast; keeps organelles in notches the model cut out of the envelope).
CONTAINMENT_MODE=mask

# --- Scale ---
# Pixels per micrometre. Leave empty to require it on every request (recommended,
# because it differs between magnifications). Example only - verify for your images.
PX_PER_UM=

# --- Optional AI-written report (OpenAI-compatible chat-completions endpoint) ---
# Leave empty to disable; quantification works without it. Only numbers are sent.
API_KEY=
API_URL=
LLM_MODEL=
LLM_TIMEOUT=60
